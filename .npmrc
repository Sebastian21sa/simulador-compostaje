# pnpm por defecto instala node_modules con symlinks a un almacen interno
# (.pnpm/). El empaquetador de funciones serverless de Vercel no siempre
# puede seguir esos symlinks correctamente cuando se incluyen archivos de
# forma manual con outputFileTracingIncludes (necesario para el binario
# nativo de onnxruntime-node) -- produce el error "invalid deployment
# package ... files in symlinked directories". node-linker=hoisted hace que
# pnpm instale en una estructura plana (como npm/yarn), sin symlinks.
node-linker=hoisted
